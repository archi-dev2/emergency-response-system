# LifeLink - Environment Variables
# Copy this file to .env.local and fill in your values

# Database (SQLite — path is relative to prisma/schema.prisma location)
# For PostgreSQL (Vercel/Neon/Supabase), change to: postgresql://user:pass@host/db
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Google Gemini API Key — powers the AI Medical Chatbot
# Get yours at https://aistudio.google.com/app/apikey
# Without this, the chatbot falls back to local keyword-based responses (still works)
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB Sidecar URL — Harrison's Manual 20e knowledge base
# Start the sidecar first: cd model && uvicorn chroma_server:app --port 8001
# If not running, the AI still works but without the Harrison's Manual context
CHROMA_SERVER_URL=http://localhost:8001
