generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  phone              String   @default("")
  role               String   @default("PATIENT")
  bloodGroup         String?
  dateOfBirth        String?
  gender             String?
  address            String?
  isVerified         Boolean  @default(false)
  allergies          String   @default("[]")
  currentMedications String   @default("[]")
  chronicConditions  String   @default("[]")
  hospitalId         String?
  metadata           String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  emergencyContacts EmergencyContact[]
  medicalRecords    MedicalRecord[]
  notifications     Notification[]
  emergencies       EmergencyRequest[] @relation("PatientEmergencies")
  ambulance         Ambulance?
  hospital          Hospital?          @relation(fields: [hospitalId], references: [id])
}

model EmergencyContact {
  id           String @id @default(cuid())
  userId       String
  name         String
  relationship String
  phone        String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Hospital {
  id              String  @id @default(cuid())
  name            String
  address         String
  city            String
  latitude        Float
  longitude       Float
  phone           String
  email           String
  totalBeds       Int     @default(100)
  availableBeds   Int     @default(20)
  icuTotal        Int     @default(10)
  icuAvailable    Int     @default(3)
  emergencyRating Float   @default(4.5)
  isActive        Boolean @default(true)
  specializations String  @default("[]")
  createdAt       DateTime @default(now())

  staff      User[]
  ambulances Ambulance[]
  emergencies EmergencyRequest[]
}

model Ambulance {
  id               String  @id @default(cuid())
  vehicleNumber    String  @unique
  driverName       String
  driverPhone      String
  status           String  @default("AVAILABLE")
  currentLatitude  Float   @default(28.6139)
  currentLongitude Float   @default(77.209)
  hospitalId       String?
  driverId         String? @unique
  createdAt        DateTime @default(now())

  hospital    Hospital?          @relation(fields: [hospitalId], references: [id])
  driver      User?              @relation(fields: [driverId], references: [id])
  emergencies EmergencyRequest[]
}

model EmergencyRequest {
  id               String   @id @default(cuid())
  patientId        String
  ambulanceId      String?
  hospitalId       String?
  status           String   @default("PENDING")
  severity         Int      @default(1)
  description      String?
  patientLatitude  Float
  patientLongitude Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient   User       @relation("PatientEmergencies", fields: [patientId], references: [id])
  ambulance Ambulance? @relation(fields: [ambulanceId], references: [id])
  hospital  Hospital?  @relation(fields: [hospitalId], references: [id])
  timeline  EmergencyTimeline[]
}

model EmergencyTimeline {
  id          String   @id @default(cuid())
  emergencyId String
  event       String
  description String?
  timestamp   String
  emergency   EmergencyRequest @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id           String   @id @default(cuid())
  patientId    String
  type         String
  title        String
  description  String?
  date         String
  doctorName   String?
  hospitalName String?
  fileUrl      String?
  createdAt    DateTime @default(now())
  patient      User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("SYSTEM")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
